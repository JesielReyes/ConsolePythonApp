# This file is a reference template. The application currently reads
# DATABASE_URL from the active shell and does not load .env automatically.

# Docker PostgreSQL from the host Python environment
DATABASE_URL=postgresql+psycopg://myuser:mysecretpassword@127.0.0.1:5433/mydb

# Native PostgreSQL alternative
# DATABASE_URL=postgresql+psycopg://<user>:<password>@127.0.0.1:5432/<database>
